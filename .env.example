# Local Docker development. Use a long random URL-safe password (letters/digits).
POSTGRES_PASSWORD=replace-with-a-long-random-password
BASE_URL=http://localhost:8010
ALLOWED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010
COOKIE_SECURE=false
IMAGE_TAG=local
# For a pilot: actual DNS domain, BASE_URL=https://domain, matching ALLOWED_ORIGINS,
# COOKIE_SECURE=true, then docker compose --profile https up -d
DOMAIN=localhost
